# Never upload local secrets, builds or dependencies to Vercel.
.env*
!.env.example
supabase/.env
supabase/.temp
.vercel-token
node_modules
.next
.netlify
*.tsbuildinfo

# The Expo app (top-level mobile/) is built separately (EAS), never by Vercel. Anchored with /
# so it does not also exclude src/app/api/mobile or src/lib/mobile.
/mobile
