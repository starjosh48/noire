# NOIRÉ app configuration. Public values only: never put a service-role key, Google client
# secret, Paystack secret or Mailgun key here (EXPO_PUBLIC_ values are built into the app).
# Copy to .env.local for development.

# The NOIRÉ website, which serves the app's API and images. Leave unset in development: the
# app then uses the computer running `expo start` on port 3100 (npm run dev -- -p 3100).
# Release builds: the live site, e.g. https://your-domain
EXPO_PUBLIC_API_URL=

# The SAME Supabase project as the website (Dashboard → Project Settings → API).
# Leave the URL unset to use a local Supabase (npx supabase start) on the dev computer.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
