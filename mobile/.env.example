# Where the app finds the NOIRÉ API (the website). Leave unset during development: the app then
# uses the computer running `expo start`, on port 3100 (run the website with `npm run dev -- -p 3100`).
# For a release build, set it to the live site, e.g. EXPO_PUBLIC_API_URL=https://your-domain
EXPO_PUBLIC_API_URL=
